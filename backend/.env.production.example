# BuildIQ production backend environment example.
# Copy to backend/.env.production on the server and fill secrets there.
# Do not commit real production values.

BUILDIQ_ENV=production
BUILDIQ_DEBUG=false
BUILDIQ_SECRET_KEY=REPLACE_WITH_A_UNIQUE_64_CHARACTER_RANDOM_SECRET
BUILDIQ_DATABASE_URL=postgresql+psycopg://buildiq:CHANGE_ME@127.0.0.1:5432/buildiq
BUILDIQ_ALLOWED_ORIGINS=https://app.example.invalid
BUILDIQ_STORAGE_PATH=/absolute/private/path/to/buildiq-storage

BUILDIQ_APP_NAME=BuildIQ Backend
BUILDIQ_SERVICE_NAME=buildiq-backend
BUILDIQ_APP_VERSION=0.9.0-rc1
BUILDIQ_API_V1_PREFIX=/api/v1
BUILDIQ_LOG_LEVEL=INFO
BUILDIQ_JWT_ALGORITHM=HS256
BUILDIQ_ACCESS_TOKEN_EXPIRE_MINUTES=60
