BUILDIQ_APP_NAME=BuildIQ Backend
BUILDIQ_SERVICE_NAME=buildiq-backend
BUILDIQ_APP_VERSION=0.1.0
BUILDIQ_ENVIRONMENT=local
BUILDIQ_DEBUG=false
BUILDIQ_API_V1_PREFIX=/api/v1
BUILDIQ_DATABASE_URL=postgresql+psycopg://buildiq:buildiq@localhost:5432/buildiq
BUILDIQ_LOG_LEVEL=INFO
BUILDIQ_JWT_SECRET_KEY=change-me-in-local-development-secret-key
BUILDIQ_JWT_ALGORITHM=HS256
BUILDIQ_ACCESS_TOKEN_EXPIRE_MINUTES=60
BUILDIQ_STORAGE_PATH=../storage
